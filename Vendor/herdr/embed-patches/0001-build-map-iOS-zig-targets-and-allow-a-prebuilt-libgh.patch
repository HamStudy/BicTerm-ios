From 89a5337457bc254a8aacad080cfe620b602edd31 Mon Sep 17 00:00:00 2001
From: BicTerm <embed@bicterm.invalid>
Date: Sun, 13 Sep 2026 08:07:52 -0600
Subject: [PATCH 1/4] build: map iOS zig targets and allow a prebuilt
 libghostty-vt

zig_target() now maps aarch64-apple-ios and aarch64-apple-ios-sim so
cross builds stop panicking in build.rs, and the new
HERDR_LIBGHOSTTY_VT_PREBUILT variable links a supplied static lib
instead of invoking the vendored zig build for hosts where that cannot
run.
---
 build.rs | 24 ++++++++++++++++++++++++
 1 file changed, 24 insertions(+)

diff --git a/build.rs b/build.rs
index 7a2ac11..3c7f45e 100644
--- a/build.rs
+++ b/build.rs
@@ -11,6 +11,8 @@ fn zig_target(target: &str) -> &str {
         "aarch64-unknown-linux-musl" => "aarch64-linux-musl",
         "x86_64-apple-darwin" => "x86_64-macos",
         "aarch64-apple-darwin" => "aarch64-macos",
+        "aarch64-apple-ios" => "aarch64-ios",
+        "aarch64-apple-ios-sim" => "aarch64-ios-simulator",
         "x86_64-pc-windows-msvc" => "x86_64-windows-msvc",
         "aarch64-pc-windows-msvc" => "aarch64-windows-msvc",
         other => panic!("unsupported target for libghostty-vt build: {other}"),
@@ -29,8 +31,30 @@ fn env_bool(name: &str) -> Option<bool> {
     }
 }
 
+fn prebuilt_lib_dir() -> Option<PathBuf> {
+    match env::var("HERDR_LIBGHOSTTY_VT_PREBUILT") {
+        Ok(value) if value == "1" => Some(
+            PathBuf::from(env::var("CARGO_MANIFEST_DIR").expect("CARGO_MANIFEST_DIR"))
+                .join("vendor/libghostty-vt/zig-out/lib"),
+        ),
+        Ok(value) => Some(PathBuf::from(value)),
+        Err(env::VarError::NotPresent) => None,
+        Err(err) => panic!("failed to read HERDR_LIBGHOSTTY_VT_PREBUILT: {err}"),
+    }
+}
+
 fn main() {
     println!("cargo:rerun-if-changed=build.rs");
+    println!("cargo:rerun-if-env-changed=HERDR_LIBGHOSTTY_VT_PREBUILT");
+    if let Some(prebuilt) = prebuilt_lib_dir() {
+        // Escape hatch for hosts where `zig build` cannot run (macOS 26
+        // build-runner link regression) and for cross-compiling embedders:
+        // link a supplied libghostty-vt.a ("1" = vendored zig-out/lib, or a
+        // directory path) instead of invoking the vendored zig build.
+        println!("cargo:rustc-link-search=native={}", prebuilt.display());
+        println!("cargo:rustc-link-lib=static=ghostty-vt");
+        return;
+    }
     println!("cargo:rerun-if-changed=vendor/libghostty-vt.vendor.json");
     println!("cargo:rerun-if-changed=vendor/libghostty-vt/build.zig");
     println!("cargo:rerun-if-changed=vendor/libghostty-vt/build.zig.zon");
