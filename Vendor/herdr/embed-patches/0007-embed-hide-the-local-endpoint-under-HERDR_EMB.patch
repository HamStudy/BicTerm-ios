+        assert_eq!(endpoints.active_id(), &ClientEndpointId::Local);
+        assert!(!endpoints.active_surface_available());
+        assert!(state
+            .shell
+            .as_ref()
+            .unwrap()
+            .endpoint_is_active(&survivor));
+        assert!(!state.shell.as_ref().unwrap().has_presented_surface());
