+// BICTERM-PATCH (embed): HERDR_EMBED_HIDE_LOCAL hides Local only under the
+// embed feature and only for the exact value "1".
+#[cfg(feature = "bicterm-embed")]
+#[test]
+fn embed_hide_local_requires_exact_one() {
+    let _lock = env_lock().lock().unwrap();
+    {
+        let _guard = EnvVarsRemovedGuard::new(&[EMBED_HIDE_LOCAL_ENV]);
+        assert!(embed_include_local_endpoint());
+    }
+    {
+        let _guard = EnvVarGuard::set(EMBED_HIDE_LOCAL_ENV, "1");
+        assert!(!embed_include_local_endpoint());
+    }
+    for value in ["0", "true", "01", " 1", "1 "] {
+        let _guard = EnvVarGuard::set(EMBED_HIDE_LOCAL_ENV, value);
+        assert!(
+            embed_include_local_endpoint(),
+            "value {value:?} must not hide Local"
+        );
+    }
+}
+
