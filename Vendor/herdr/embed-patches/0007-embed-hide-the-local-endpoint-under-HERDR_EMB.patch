+// BICTERM-PATCH (embed): hidden Local with an empty catalog — the Local id
+// stays the internal no-active sentinel, the frame says so, and the new
+// workspace footer stays disabled until a machine activates.
+#[cfg(feature = "bicterm-embed")]
+#[test]
+fn hidden_local_empty_catalog_presents_no_machine_selected() {
+    let mut state = ClientShellState::new(
+        ClientShellConfig::from_config(&Config::default()).with_local_endpoint_visibility(false),
+    );
+    state.set_endpoint_catalog(&[]);
+    assert!(state.endpoints.is_empty());
+    assert!(state.endpoint_is_active(&ClientEndpointId::Local));
+    let frame = state.compose(100, 28).expect("no-machine frame composes");
+    let buffer = frame.to_ratatui_buffer().unwrap();
+    let text = buffer
+        .content()
+        .iter()
+        .map(|cell| cell.symbol())
+        .collect::<String>();
+    assert!(text.contains("No machine selected"));
+    assert!(state.hits.new_workspace.is_empty());
+}
