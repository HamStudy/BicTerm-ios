+// BICTERM-PATCH (embed): hidden Local — catalog rows are exactly the saved
+// machines, and a sole machine still gets endpoint chrome and machine hits.
+#[cfg(feature = "bicterm-embed")]
+#[test]
+fn hidden_local_single_machine_uses_endpoint_chrome() {
+    let mut state = ClientShellState::new(
+        ClientShellConfig::from_config(&Config::default()).with_local_endpoint_visibility(false),
+    );
+    assert!(state.endpoints.is_empty());
+    let profile = remote_profile();
+    let remote = ClientEndpointId::Ssh(profile.id.clone());
+    state.set_endpoint_catalog(&[profile]);
+    assert_eq!(state.endpoints.len(), 1);
+    assert!(
+        !state
+            .endpoints
+            .iter()
+            .any(|endpoint| endpoint.endpoint_id.is_local())
+    );
+    assert!(state.endpoint_is_active(&remote));
+    assert!(state.endpoint_status(&ClientEndpointId::Local).is_none());
+    state.set_endpoint_status(&remote, ClientEndpointStatus::Online);
+    state.set_endpoint_snapshot(&remote, Box::new(snapshot()));
+    state
+        .compose(100, 28)
+        .expect("single machine without Local composes");
+    assert!(
+        state
+            .hits
+            .machines
+            .iter()
+            .any(|hit| hit.endpoint_id == remote)
+    );
+    assert!(
+        !state
+            .hits
+            .machines
+            .iter()
+            .any(|hit| hit.endpoint_id.is_local())
+    );
+}
