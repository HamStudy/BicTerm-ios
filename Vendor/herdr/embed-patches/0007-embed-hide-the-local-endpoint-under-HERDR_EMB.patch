+    // BICTERM-PATCH (embed): hidden Local — removing the active machine
+    // selects the enabled survivor instead of falling back to Local.
+    #[cfg(feature = "bicterm-embed")]
+    #[test]
+    fn hidden_local_remove_active_machine_selects_enabled_survivor() {
+        let now = Instant::now();
+        let mut state = state_without_local();
+        let mut catalog = EndpointCatalog::default();
+        let removed_id = catalog.add_ssh("Old", "old", "main").unwrap();
+        let survivor_id = catalog.add_ssh("Stay", "stay", "main").unwrap();
+        let removed = ClientEndpointId::Ssh(removed_id.clone());
+        let survivor = ClientEndpointId::Ssh(survivor_id.clone());
+        catalog.select_ssh(&removed_id);
+        state
+            .shell
+            .as_mut()
+            .unwrap()
+            .set_endpoint_catalog(&catalog.ssh);
+        let mut supervisors = EndpointSupervisors::new(&catalog.ssh, now);
+        let mut endpoints = EndpointRegistry::empty();
+        let removed_disconnects = Arc::new(AtomicUsize::new(0));
+        endpoints.insert(
+            removed.clone(),
+            Transport(removed_disconnects.clone()),
+            2,
+            Default::default(),
+            true,
+        );
+        endpoints.set_active(&removed);
+        endpoints.unfreeze_input();
+        let mut commands = endpoint_commands::EndpointCommands::default();
+        let profiles: Vec<_> = catalog
+            .ssh
+            .iter()
+            .filter(|profile| profile.id == survivor_id)
+            .cloned()
+            .collect();
