         self.config.include_local_endpoint
     }
 
+    /// BICTERM-PATCH (embed): the machines the shell currently reports as
+    /// needing attention — the supervisor re-arm set for a catalog reload.
+    /// The shell status mirrors the supervisor's record_status outcome.
+    #[cfg(feature = "bicterm-embed")]
+    pub(crate) fn attention_endpoint_ids(&self) -> Vec<ClientEndpointId> {
+        self.endpoints
+            .iter()
+            .filter(|endpoint| endpoint.status == ClientEndpointStatus::Attention)
+            .map(|endpoint| endpoint.endpoint_id.clone())
+            .collect()
+    }
+
     #[cfg(test)]
     pub(crate) fn set_snapshot(&mut self, snapshot: Box<ClientShellSnapshot>) {
         let endpoint_id = self.active_endpoint_id.clone();
