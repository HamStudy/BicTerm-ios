From 69435c05f6c5d511e171b692b1836cc404205a5c Mon Sep 17 00:00:00 2001
From: BicTerm <embed@bicterm.invalid>
Date: Sun, 13 Sep 2026 08:07:52 -0600
Subject: [PATCH 2/4] platform: cover remaining unix helpers in the fallback
 platform

unix fallback targets (ios and friends) failed to compile because
wait_client_stream_readable was only re-exported by the linux and macos
modules and foreground_process_group_id_for_tty_fd was not defined at
all; both are plain unix facilities, so provide them under cfg(unix).
---
 src/platform/fallback.rs | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/src/platform/fallback.rs b/src/platform/fallback.rs
index 09d82c6..fb88b31 100644
--- a/src/platform/fallback.rs
+++ b/src/platform/fallback.rs
@@ -6,6 +6,15 @@ use super::{ClipboardImage, ForegroundJob, Signal};
 #[cfg(unix)]
 pub(crate) use super::unix_common::set_default_plugin_pane_pwd;
 
+#[cfg(unix)]
+pub(crate) use super::unix_common::wait_client_stream_readable;
+
+#[cfg(unix)]
+pub fn foreground_process_group_id_for_tty_fd(fd: std::os::fd::RawFd) -> Option<u32> {
+    let pgid = unsafe { libc::tcgetpgrp(fd) };
+    (pgid > 0).then_some(pgid as u32)
+}
+
 #[cfg(not(unix))]
 pub(crate) fn set_default_plugin_pane_pwd(
     _env: &mut Vec<(String, String)>,
-- 
