# opencode: machine-local MCP tool config (carries absolute checkout paths)
opencode.json

# XcodeGen: generated project, regenerated via `xcodegen generate` (see project.yml)
*.xcodeproj/
# ...except the SwiftPM resolution pin, the only workspace-level reproducibility
# lock for the vendored swift-nio-ssh fork (its Package.swift uses version ranges).
# git cannot re-include a file whose parent dir is excluded, so unignore each level.
!BicTerm.xcodeproj/
BicTerm.xcodeproj/*
!BicTerm.xcodeproj/project.xcworkspace/
BicTerm.xcodeproj/project.xcworkspace/*
!BicTerm.xcodeproj/project.xcworkspace/xcshareddata/
BicTerm.xcodeproj/project.xcworkspace/xcshareddata/*
!BicTerm.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
BicTerm.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/*
!BicTerm.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved

# herdr: re-downloadable upstream reference copies (see Vendor/herdr/PROVENANCE.md)
Vendor/herdr/upstream/
Vendor/herdr/UPSTREAM_SOURCE.tar
# herdr: Rust build outputs under the FFI crate and fuzz harness
Vendor/herdr/**/target/
# herdr: accumulated cargo-fuzz corpus (generated fuzzing input, ~64 MB)
Vendor/herdr/herdr-ios-ffi/fuzz/corpus/
