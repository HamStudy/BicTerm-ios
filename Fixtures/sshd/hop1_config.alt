# BicTerm fixture sshd — hop-1 ALTERNATE host key config.
# Identical to hop1_config except HostKey points at the SECOND, distinct
# host key (Fixtures/sshd/host_key_alt/). T7's changed-host-key test starts
# hop1 with this config (or uses fixtures-up.sh HOP1_ALT_KEY=1) so the client
# observes a different host identity on 127.0.0.1:12222.
Port 12222
ListenAddress 127.0.0.1
Protocol 2

HostKey /Users/richard/code/BicTerm-ios/Fixtures/sshd/host_key_alt/hop1_host_ed25519
PidFile /Users/richard/code/BicTerm-ios/Fixtures/run/hop1.pid

PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin no
AuthorizedKeysFile /Users/richard/code/BicTerm-ios/Fixtures/sshd/authorized_keys_hop1

AllowTcpForwarding yes
AllowAgentForwarding yes
PermitTTY yes
PermitTunnel no
X11Forwarding no
PermitUserEnvironment no

StrictModes no
UsePAM no
AuthorizedKeysCommand none
IgnoreUserKnownHosts yes

LogLevel DEBUG3

AcceptEnv BICTERM_*
PrintMotd no

# herdr fixture: the FIXED remote-client-bridge command built by
# HerdrCommandBuilder cannot carry an env prefix, so the per-port fixture
# herdr server socket is injected here (see scripts/fixtures-up.sh §herdr).
SetEnv HERDR_SOCKET_PATH=/Users/richard/code/BicTerm-ios/Fixtures/run/herdr/server-12222/herdr.sock
